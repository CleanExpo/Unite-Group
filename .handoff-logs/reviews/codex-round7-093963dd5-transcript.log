   147	echo "  before revoke: authenticated read returned 1 row"
   148	echo "  after  revoke: has_function_privilege=false AND permission denied for function get_my_org_ids"
   149	echo "  transaction rolled back; schema rlsproof absent"
     1	#!/usr/bin/env bash
     2	# Runnable wrapper for the production exposure gate.
     3	#
     4	# prod-exposure.sql states its contract in prose — "every query MUST return ZERO
     5	# rows" — which makes it an assertion a human has to eyeball, not a gate. This
     6	# wrapper turns the contract into an exit code so CI, a founder, or a hostile
     7	# auditor gets a verdict rather than a result set.
     8	#
     9	#   usage: run-prod-exposure.sh <postgres-uri> [--control <admin-uri-to-a-NON-PROD-cluster>]
    10	#
    11	#   exit 0  no rows, AND every rule was proven able to detect its own defect
    12	#   exit 1  one or more exposure rows returned    gate FAIL, findings printed
    13	#   exit 2  could not run, or the green could not be trusted (see below)
    14	#
    15	# Exit 2 is deliberately distinct from exit 1. A gate that cannot connect must
    16	# never be read as a pass — an unreachable database and a clean one both produce
    17	# no rows, and collapsing them is how a false green is manufactured.
    18	#
    19	# ── WHY --control EXISTS (independent review, codex, 19/08/2026) ─────────────
    20	# An earlier revision guarded the green by asserting prod-exposure.sql still
    21	# DECLARED all three rules. That checks the label, not the behaviour. The
    22	# reviewer kept all three declaration strings and changed every predicate to
    23	# `WHERE false`: the guard accepted it and the wrapper printed
    24	# "PASS ... 0 rows across all 3 declared queries" while two seeded exposures were
    25	# live. A green is only meaningful if the queries can still FIND something, and
    26	# the only honest way to know that is to make them find something.
    27	#
    28	# We cannot seed a defect into production to test the gate. So the positive
    29	# control runs on a throwaway database on a cluster you nominate with --control:
    30	# one exposure per rule is seeded, the real gate file is run, and every rule must
    31	# come back RED. Only then is a green against the real target trusted.
    32	#
    33	# Without --control the wrapper will NOT print PASS. It reports UNVERIFIED and
    34	# exits 2, because "0 rows from queries that may or may not work" is not a pass.
    35	set -uo pipefail
    36	
    37	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    38	GATE="$HERE/prod-exposure.sql"
    39	
    40	CONN=""
    41	CONTROL=""
    42	while [[ $# -gt 0 ]]; do
    43	  case "$1" in
    44	    --control) CONTROL="${2:-}"; shift 2 ;;
    45	    -h|--help) echo "usage: $(basename "$0") <postgres-uri> [--control <admin-uri>]"; exit 2 ;;
