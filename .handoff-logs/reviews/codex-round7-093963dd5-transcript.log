     1	#!/usr/bin/env bash
     2	# Proves the load-bearing claim behind ship-board item 6 and FOUNDER-QUEUE F9:
     3	#
     4	#   Postgres checks function EXECUTE against the QUERYING role when it evaluates
     5	#   an RLS policy expression. SECURITY DEFINER on the callee does NOT exempt it.
     6	#
     7	# Consequence: revoking `authenticated` EXECUTE on get_my_org_ids() makes every
     8	# authenticated read of an org-membership-scoped table fail outright. That is why
     9	# 2026-08-19-privileged-function-exposure-lock.sql deliberately RETAINS
    10	# `authenticated` on that one function, and why the exposure gate cannot exit 0
    11	# while its query 3 flags any definer executable by `authenticated`.
    12	#
    13	# Usage: scripts/ship-gates/prove-rls-execute-coupling.sh "<postgres-uri>"
    14	#
    15	# WHY THE SQL IS INLINE AND NOT A SEPARATE FILE. An earlier revision read the
    16	# experiment from prove-rls-execute-coupling.sql and authenticated the run by
    17	# grepping three substrings out of psql's output. An independent review (codex,
    18	# 19/08/2026) broke it in one move: a "mutant" SQL file containing nothing but
    19	#   \echo BEFORE_REVOKE_ROWS=1
    20	#   \echo permission denied for function get_my_org_ids
    21	#   \echo ROLLBACK
    22	# created no schema, role, function, table, policy, grant or transaction, and the
    23	# wrapper printed PASS. The gate authenticated forgeable strings, not the
    24	# experiment. The SQL now lives in this file, so there is no separate artefact to
    25	# swap, and the assertions below check catalog state rather than echoed text.
    26	#
    27	# Exits 0 only if ALL of the following hold, each read back from the database:
    28	#   - the helper really is SECURITY DEFINER and the table really has RLS enabled
    29	#   - before the revoke, the authenticated read returns exactly 1 row
    30	#   - after the revoke, the same read fails with "permission denied for function"
    31	#   - the role really has lost EXECUTE (catalog check, not message text)
    32	#   - nothing persists: the schema and role are gone afterwards
    33	set -uo pipefail
    34	
    35	URI="${1:-}"
    36	if [[ -z "$URI" ]]; then
    37	  echo "usage: $0 \"<postgres-uri>\"" >&2
    38	  exit 2
    39	fi
    40	command -v psql >/dev/null 2>&1 || { echo "cannot run: psql not on PATH" >&2; exit 2; }
    41	
    42	WORK="$(mktemp -d)"
    43	trap 'rm -rf "$WORK"' EXIT
    44	
    45	fail() {
    46	  echo "FAIL  prove-rls-execute-coupling: $1"
    47	  [[ -s "$WORK/out" ]] && { echo "── psql output ──"; cat "$WORK/out"; }
    48	  exit 1
    49	}
    50	
    51	# One transaction, rolled back. Every marker below is printed by a SELECT over
    52	# catalog or table state — never by \echo — so the marker cannot appear unless
    53	# the statement that produces it actually ran.
    54	psql "$URI" -X -A -t -q -v ON_ERROR_STOP=0 >"$WORK/out" 2>&1 <<'SQL'
    55	BEGIN;
    56	
    57	CREATE SCHEMA rlsproof;
    58	CREATE ROLE rlsproof_authenticated NOLOGIN;
    59	GRANT rlsproof_authenticated TO current_user;
    60	
    61	-- The tenancy helper, exactly as production has it: SECURITY DEFINER.
    62	CREATE FUNCTION rlsproof.get_my_org_ids()
    63	RETURNS SETOF uuid LANGUAGE sql SECURITY DEFINER STABLE
    64	AS $fn$ SELECT '11111111-1111-1111-1111-111111111111'::uuid $fn$;
    65	
    66	CREATE TABLE rlsproof.organizations (id uuid PRIMARY KEY);
    67	INSERT INTO rlsproof.organizations (id) VALUES ('11111111-1111-1111-1111-111111111111');
    68	ALTER TABLE rlsproof.organizations ENABLE ROW LEVEL SECURITY;
    69	
    70	-- Org-membership-scoped policy that CALLS the definer, as production does.
    71	CREATE POLICY orgs_select ON rlsproof.organizations
    72	  FOR SELECT TO rlsproof_authenticated
    73	  USING (id IN (SELECT rlsproof.get_my_org_ids()));
    74	
    75	GRANT USAGE ON SCHEMA rlsproof TO rlsproof_authenticated;
    76	GRANT SELECT ON rlsproof.organizations TO rlsproof_authenticated;
    77	GRANT EXECUTE ON FUNCTION rlsproof.get_my_org_ids() TO rlsproof_authenticated;
    78	
    79	-- Read back the SETUP from the catalog. A forged run cannot produce these.
    80	SELECT 'SETUP_DEFINER=' || p.prosecdef::text
    81	  FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    82	 WHERE n.nspname = 'rlsproof' AND p.proname = 'get_my_org_ids';
    83	SELECT 'SETUP_RLS=' || c.relrowsecurity::text
    84	  FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    85	 WHERE n.nspname = 'rlsproof' AND c.relname = 'organizations';
    86	SELECT 'SETUP_POLICIES=' || count(*)::text FROM pg_policies
    87	 WHERE schemaname = 'rlsproof' AND tablename = 'organizations';
    88	SELECT 'SETUP_EXECUTE=' || has_function_privilege('rlsproof_authenticated', p.oid, 'EXECUTE')::text
    89	  FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
    90	 WHERE n.nspname = 'rlsproof' AND p.proname = 'get_my_org_ids';
    91	
    92	-- BEFORE: the role HOLDS EXECUTE. The count comes from the table itself.
    93	SET LOCAL ROLE rlsproof_authenticated;
    94	SELECT 'BEFORE_REVOKE_ROWS=' || count(*)::text FROM rlsproof.organizations;
    95	RESET ROLE;
    96	
    97	-- ── THE REVOKE UNDER TEST ───────────────────────────────────────────────────
    98	REVOKE ALL ON FUNCTION rlsproof.get_my_org_ids() FROM PUBLIC;
    99	REVOKE ALL ON FUNCTION rlsproof.get_my_org_ids() FROM rlsproof_authenticated;
   100	
   101	-- Catalog proof that the privilege is actually gone, independent of any message.
   102	SELECT 'AFTER_EXECUTE=' || has_function_privilege('rlsproof_authenticated', p.oid, 'EXECUTE')::text
   103	  FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
   104	 WHERE n.nspname = 'rlsproof' AND p.proname = 'get_my_org_ids';
   105	
   106	-- AFTER: same read, same role. Expect: permission denied for function.
   107	SET LOCAL ROLE rlsproof_authenticated;
   108	SELECT 'AFTER_REVOKE_ROWS=' || count(*)::text FROM rlsproof.organizations;
   109	RESET ROLE;
   110	
   111	ROLLBACK;
   112	SQL
   113	
   114	OUT="$(cat "$WORK/out")"
   115	has() { grep -qF "$1" <<<"$OUT"; }
   116	
   117	# ── the experiment must have been BUILT ──────────────────────────────────────
   118	has 'SETUP_DEFINER=t'  || fail "setup not established: the helper is not SECURITY DEFINER (no SETUP_DEFINER=t). Nothing below proves anything."
   119	has 'SETUP_RLS=t'      || fail "setup not established: row-level security is not enabled on the table (no SETUP_RLS=t)."
   120	has 'SETUP_POLICIES=1' || fail "setup not established: expected exactly 1 policy over the table (no SETUP_POLICIES=1)."
   121	has 'SETUP_EXECUTE=t'  || fail "setup not established: the role does not hold EXECUTE before the revoke (no SETUP_EXECUTE=t)."
   122	
   123	# ── half 1: the read works while EXECUTE is held ─────────────────────────────
   124	has 'BEFORE_REVOKE_ROWS=1' \
   125	  || fail "baseline missing: the authenticated read must return exactly 1 row BEFORE the revoke, or the second half proves nothing."
   126	
   127	# ── the revoke must have actually taken, per the catalog ─────────────────────
   128	has 'AFTER_EXECUTE=f' \
   129	  || fail "the revoke did not take: has_function_privilege still reports EXECUTE after it (no AFTER_EXECUTE=f)."
   130	
   131	# ── half 2: the same read now breaks, naming the function ────────────────────
   132	has 'permission denied for function get_my_org_ids' \
   133	  || fail "claim NOT reproduced: expected 'permission denied for function get_my_org_ids' after the revoke."
   134	
   135	# ── and it must have broken, not quietly returned rows ───────────────────────
   136	if has 'AFTER_REVOKE_ROWS='; then
