    97	--    absence; this block is the mechanism that prevents it.
    98	DO $$
    99	DECLARE
   100	  _fn regprocedure;
   101	BEGIN
   102	  FOR _fn IN
   103	    SELECT p.oid::regprocedure
   104	    FROM pg_proc p
   105	    JOIN pg_namespace n ON n.oid = p.pronamespace
   106	    WHERE n.nspname = 'public'
   107	      AND p.proname IN ('custom_access_token_hook', 'before_user_created_hook')
   108	  LOOP
   109	    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO supabase_auth_admin', _fn);
   110	    RAISE NOTICE 'revoke_privileged_function_exposure: supabase_auth_admin re-granted EXECUTE on %', _fn;
   111	  END LOOP;
   112	END
   113	$$;
