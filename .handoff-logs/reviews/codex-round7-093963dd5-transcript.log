   123	-- that table fail outright with "permission denied for function get_my_org_ids" —
   124	-- an outage strictly worse than the exposure this file closes, and one whose only
   125	-- recovery path is the rollback, which re-opens the anon-callable JWT hook.
   126	--
   127	-- DEMONSTRATED, and here is the run. scripts/ship-gates/prove-rls-execute-coupling.sh
   128	-- builds exactly this arrangement — a SECURITY DEFINER tenancy helper, an
   129	-- org-scoped table, an RLS policy that calls the helper — and reads it as the
   130	-- authenticated role before and after the revoke:
   131	--
   132	--   before revoke: authenticated read returned 1 row
   133	--   after  revoke: ERROR: permission denied for function get_my_org_ids
   134	--
   135	-- Run 19/08/2026 against Postgres 17.6, exit 0. The gate is mutation-checked:
   136	-- with the revoke removed it exits 1 ("claim NOT reproduced"), and the source
   137	-- was restored byte-identical (shasum verified). Everything runs in one
   138	-- transaction and is ROLLBACK'd.
   139	--
   140	-- An earlier revision of this comment cited "repro-prod-exposure.sh step 9",
   141	-- which has never existed; that script has steps 0-8 and none of them tests
   142	-- this. The citation is now a script you can run.
   143	--
   144	-- `anon` is still revoked: an unauthenticated caller has no legitimate use for a
   145	-- tenancy helper. The EXECUTE for `authenticated` is re-granted EXPLICITLY after
   146	-- the PUBLIC revoke, so the PUBLIC revoke cannot strand it.
   147	DO $$
   148	DECLARE
   149	  _fn regprocedure;
   150	BEGIN
   151	  FOR _fn IN
   152	    SELECT p.oid::regprocedure
   153	    FROM pg_proc p
   154	    JOIN pg_namespace n ON n.oid = p.pronamespace
   155	    WHERE n.nspname = 'public' AND p.proname = 'get_my_org_ids'
   156	  LOOP
   157	    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC', _fn);
   158	    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM anon', _fn);
   159	    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO authenticated', _fn);
   160	    RAISE NOTICE 'revoke_privileged_function_exposure: % locked to authenticated only', _fn;
   161	  END LOOP;
   162	END
   163	$$;
   164	
   165	-- ── 4-5: dated one-off migration artefacts left in public with RLS off, so the
   166	--         anon key can read and write them over PostgREST. RLS enabled with no
   167	--         policy denies all access, which closes the exposure without deleting
   168	--         data. DROP remains the founder's call; this migration does not take
   169	--         it, because an agent dropping a table it cannot inspect is the one
   170	--         irreversible move on this board.
   171	DO $$
   172	DECLARE
   173	  _tbl text;
   174	BEGIN
   175	  FOREACH _tbl IN ARRAY ARRAY[
   176	    'public.founder_uid_migration_20260810',
   177	    'public.founder_uid_conflict_resolution_20260810'
   178	  ] LOOP
   179	    IF to_regclass(_tbl) IS NOT NULL THEN
   180	      EXECUTE format('ALTER TABLE %s ENABLE ROW LEVEL SECURITY', _tbl);
   181	      RAISE NOTICE 'revoke_privileged_function_exposure: RLS enabled on %', _tbl;
   182	    ELSE
   183	      RAISE NOTICE 'revoke_privileged_function_exposure: % absent, nothing to do', _tbl;
   184	    END IF;
   185	  END LOOP;
   186	END
   187	$$;
   188	
   189	-- ── Post-condition, enforced in the same transaction that made the change.
   190	--    Without this the migration reports success on the strength of having run,
   191	--    which is not the same as having worked.
   192	--
   193	--    It asks has_function_privilege rather than matching grantee NAMES in proacl.
   194	--    A name match misses privilege reached through role INHERITANCE: with
   195	--    `GRANT app_helper TO anon` and the definer granted to app_helper, anon can
   196	--    execute the function while no `anon=X` entry exists anywhere in proacl, and
   197	--    a name-matching check reports zero exposures over a live one.
   198	--
   199	--    It also names the offenders rather than raising a bare count, so a file
   200	--    pasted against the wrong project fails with something diagnosable.
   201	DO $$
   202	DECLARE
   203	  _anon_exposed  text[];
   204	  _authed_extra  text[];
   205	  _authadmin     int;
   206	  -- Definers `authenticated` is ALLOWED to execute. RLS helpers must be here or
   207	  -- their policies break; see the get_my_org_ids block above.
   208	  _rls_helpers   text[] := ARRAY['get_my_org_ids'];
   209	BEGIN
   210	  SELECT coalesce(array_agg(p.oid::regprocedure::text ORDER BY 1), '{}')
   211	    INTO _anon_exposed
   212	  FROM pg_proc p
   213	  JOIN pg_namespace n ON n.oid = p.pronamespace
   214	  WHERE n.nspname = 'public'
   215	    AND p.prosecdef
   216	    AND has_function_privilege('anon', p.oid, 'EXECUTE');
   217	
   218	  IF array_length(_anon_exposed, 1) > 0 THEN
   219	    RAISE EXCEPTION
   220	      'post-condition failed: SECURITY DEFINER function(s) in public still executable by anon: %',
   221	      array_to_string(_anon_exposed, ', ');
   222	  END IF;
   223	
   224	  SELECT coalesce(array_agg(p.oid::regprocedure::text ORDER BY 1), '{}')
   225	    INTO _authed_extra
   226	  FROM pg_proc p
   227	  JOIN pg_namespace n ON n.oid = p.pronamespace
   228	  WHERE n.nspname = 'public'
   229	    AND p.prosecdef
   230	    AND has_function_privilege('authenticated', p.oid, 'EXECUTE')
   231	    AND NOT (p.proname = ANY (_rls_helpers));
   232	
   233	  IF array_length(_authed_extra, 1) > 0 THEN
   234	    RAISE EXCEPTION
   235	      'post-condition failed: SECURITY DEFINER function(s) in public still executable by authenticated and not on the RLS-helper allowlist: %',
   236	      array_to_string(_authed_extra, ', ');
   237	  END IF;
   238	
   239	  -- The auth hooks must still be callable by the auth service. This is an
   240	  -- ASSERTION, not a notice: a migration that silently strands supabase_auth_admin
   241	  -- takes every login down, so it must refuse to commit rather than report.
   242	  -- Counted against the hooks that EXIST, so an absent hook cannot fake a pass.
   243	  SELECT count(*) INTO _authadmin
   244	  FROM pg_proc p
   245	  JOIN pg_namespace n ON n.oid = p.pronamespace
   246	  WHERE n.nspname = 'public'
   247	    AND p.proname IN ('custom_access_token_hook', 'before_user_created_hook')
   248	    AND NOT has_function_privilege('supabase_auth_admin', p.oid, 'EXECUTE');
   249	
   250	  IF _authadmin > 0 THEN
   251	    RAISE EXCEPTION
   252	      'post-condition failed: supabase_auth_admin lost EXECUTE on % auth hook(s) — this would lock out every login',
   253	      _authadmin;
   254	  END IF;
   255	
   256	  RAISE NOTICE 'post-condition OK: 0 anon-executable definers; 0 unexpected authenticated-executable definers; supabase_auth_admin retains EXECUTE on every auth hook present';
   257	END
   258	$$;
   259	
   260	COMMIT;
