    31	-- ROOT CAUSE. 20260620010000_auth_signup_allowlist.sql already ends each hook
    32	-- with `REVOKE EXECUTE ... FROM PUBLIC`. That revoke is real but incomplete:
    33	-- it removes the implicit PUBLIC grant and leaves any EXPLICIT `anon=X` /
    34	-- `authenticated=X` entry in proacl untouched. Production shows exactly that
    35	-- residue, which is why a migration that looks like it locked the hooks shipped
    36	-- a surface that is still anon-callable. Revoking from PUBLIC is not revoking
    37	-- from anon.
    38	--
    39	-- WHY THE REVOKES ARE NAME-DRIVEN, NOT SIGNATURE-DRIVEN. A REVOKE naming a
    40	-- signature that does not exist raises; a signature guarded by `to_regprocedure`
    41	-- that guesses wrong simply skips, silently, and the gate then reads green
    42	-- because nothing was examined. The DO block below enumerates pg_proc, so every
    43	-- overload of every named function is covered and the count of what was actually
    44	-- touched is RAISEd as a NOTICE — an assertion you can read rather than assume.
    45	--
    46	-- WHAT IS DELIBERATELY NOT HERE. No schema-wide `ALTER DEFAULT PRIVILEGES`.
    47	-- That would change the privilege model for every future function in public,
    48	-- which is a far wider blast radius than the seven boarded items and was not
    49	-- reviewed as part of them. It is recorded as a recommendation on the ship board
    50	-- instead of smuggled into an exposure fix.
    51	
    52	BEGIN;
    53	
    54	-- ── 1-3, 7: privileged functions no untrusted role may call. anon AND
    55	--            authenticated both lose EXECUTE. supabase_auth_admin MUST keep
    56	--            EXECUTE on the two auth hooks or every login breaks — it is
    57	--            re-granted below, after the revoke, so ordering cannot strand it.
    58	DO $$
    59	DECLARE
    60	  _fn      regprocedure;
    61	  _touched int := 0;
    62	BEGIN
    63	  FOR _fn IN
    64	    SELECT p.oid::regprocedure
    65	    FROM pg_proc p
    66	    JOIN pg_namespace n ON n.oid = p.pronamespace
    67	    WHERE n.nspname = 'public'
    68	      AND p.proname IN (
    69	        'custom_access_token_hook',
    70	        'before_user_created_hook',
    71	        'prune_integration_history'
    72	      )
    73	  LOOP
    74	    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC', _fn);
    75	    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM anon', _fn);
    76	    EXECUTE format('REVOKE ALL ON FUNCTION %s FROM authenticated', _fn);
    77	    _touched := _touched + 1;
    78	  END LOOP;
    79	
    80	  RAISE NOTICE 'revoke_privileged_function_exposure: revoked on % function(s)', _touched;
    81	END
