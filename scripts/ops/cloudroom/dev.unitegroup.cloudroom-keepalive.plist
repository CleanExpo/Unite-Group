<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.unitegroup.cloudroom-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Cloudroom.app/Contents/MacOS/Cloudroom</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart after a crash; a normal quit (exit 0) stays quit. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
