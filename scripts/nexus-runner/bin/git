#!/bin/sh
# nexus-runner git shim — the runner's OWN committed, portable tool-boundary
# guard (does NOT depend on the machine-level ~/.claude/night-shift shims).
# Allows exactly what the L2 mandate needs — a plain feature-branch push to
# origin so the runner can open its draft PR — and nothing more.
# Blocks: all force-push, merge, hard reset, branch -D, and any push to the
# default branch (main/master). Everything else passes to real git. Holds even
# under --dangerously-skip-permissions (the permission engine is off; this is not).
REAL_GIT="${NEXUS_RUNNER_REAL_GIT:-/usr/bin/git}"
[ -x "$REAL_GIT" ] || REAL_GIT=$(PATH=/usr/bin:/usr/local/bin:/opt/homebrew/bin command -v git)

deny() { echo "nexus-runner: BLOCKED '$*' (L2 reversible-envelope guard)" >&2; exit 3; }

# Find the real subcommand past git's global options (-C dir, -c k=v,
# --git-dir, ...), so a leading global option cannot hide a push. An alias
# defined with -c or written by `git config alias.*` could rename push, so both
# are refused. A push behind a directory-changing global option is refused:
# the default-branch check below could not see which repository it targets.
sub=""; skip=0; dirglobal=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    -c) skip=1; continue ;;
    -C|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix|--config-env) dirglobal=1; skip=1; continue ;;
    --git-dir=*|--work-tree=*|--namespace=*|--config-env=*) dirglobal=1; continue ;;
    -*) continue ;;
  esac
  sub="$a"; break
done
# Config keys that rename a command (alias.*), pull in other config (include*), or
# redirect where a push lands (push.*, remote.<name>.push, remote.<name>.mirror).
# `push.default=upstream` turned `git push origin feature-x` into a push to main
# (Cursor review round 5, confirmed with real git).
risky_key() {
  case "$1" in
    [Aa][Ll][Ii][Aa][Ss].*|[Ii][Nn][Cc][Ll][Uu][Dd][Ee].*|[Ii][Nn][Cc][Ll][Uu][Dd][Ee][Ii][Ff].*) return 0 ;;
    [Pp][Uu][Ss][Hh].*|[Rr][Ee][Mm][Oo][Tt][Ee].*.[Pp][Uu][Ss][Hh]*|[Rr][Ee][Mm][Oo][Tt][Ee].*.[Mm][Ii][Rr][Rr][Oo][Rr]*) return 0 ;;
  esac
  return 1
}
prev=""
for a in "$@"; do
  case "$prev" in -c) risky_key "$a" && deny "git -c $a (alias, include or push-redirect override)" ;; esac
  prev="$a"
done
if [ "$sub" = config ]; then
  for a in "$@"; do risky_key "$a" && deny "git config $a (alias, include or push-redirect key)"; done
fi

case "$sub" in
  push)
    [ "$dirglobal" = 0 ] || deny "git push behind -C/--git-dir/--work-tree (push from inside the worktree)"
    seen=0; npos=0; nrefs=0
    for a in "$@"; do
      # the first positional after `push` is the remote, not a refspec: `git push main feature-x`
      # names a remote called main; only refspecs are checked for tags and default-branch targets
      isref=0
      case "$a" in
        -*) : ;;
        *) if [ "$seen" = 1 ]; then npos=$((npos + 1)); [ "$npos" -ge 2 ] && isref=1; fi
           [ "$a" = push ] && seen=1 ;;
      esac
      case "$a" in
        # forbid all force, including a +refspec
        --force|--force-with-lease|-f|--force-with-lease=*|--force-if-includes|+*) deny "git push force ($a)" ;;
        # forbid deleting remote refs (--delete, -d, an empty-source :ref refspec, --mirror, --prune)
        --delete|-d|--mirror|--prune|:*) deny "git push delete ($a)" ;;
        # forbid pushing every branch (which includes main) and tags (which can trigger releases)
        --all|--branches|--tags|--follow-tags|tag|refs/tags/*|*:refs/tags/*) deny "git push $a" ;;
      esac
      [ "$isref" = 1 ] || continue
      nrefs=$((nrefs + 1))
      # forbid pushing a tag named bare (`git push origin v1.0.0`): ask git whether the source is a
      # tag. A name that is also a branch is left to git, which refuses the ambiguous refspec itself.
      src="${a%%:*}"
      if [ -n "$src" ] && "$REAL_GIT" show-ref --verify --quiet "refs/tags/$src" 2>/dev/null &&
        ! "$REAL_GIT" show-ref --verify --quiet "refs/heads/$src" 2>/dev/null; then
        deny "git push tag ($a)"
      fi
      # forbid a main/master destination, however spelled (main, x:main, refs/heads/main)
      dst="${a##*:}"
      dst="${dst#refs/heads/}"
      case "$dst" in main|master) deny "git push to default branch ($a)" ;; esac
    done
    # forbid a push while the current branch IS the default branch
    br=$("$REAL_GIT" rev-parse --abbrev-ref HEAD 2>/dev/null)
    case "$br" in
      main|master) deny "git push from default branch ($br)" ;;
    esac
    # a push must name what it pushes: a bare `git push` / `git push origin` follows
    # push.default, remote.*.push and the branch upstream, any of which can point at main
    [ "$nrefs" -ge 1 ] || deny "git push without an explicit branch (name it: git push -u origin <branch>)"
    # pin push.default=current for this push, above any repository or global config, so an
    # explicit `<branch>` refspec always lands on the same-named remote branch
    unset GIT_CONFIG_PARAMETERS
    GIT_CONFIG_COUNT=1; GIT_CONFIG_KEY_0=push.default; GIT_CONFIG_VALUE_0=current
    export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
    ;;
  merge)        deny "git merge" ;;
  reset)
    for a in "$@"; do case "$a" in --hard) deny "git reset --hard" ;; esac; done ;;
  branch)
    for a in "$@"; do case "$a" in -D|-Dr|--delete) deny "git branch delete" ;; esac; done ;;
esac
exec "$REAL_GIT" "$@"
