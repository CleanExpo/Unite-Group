#!/bin/sh
# nexus-runner vercel shim (policy: ../mission-authority.json). A preview
# deployment is a build step and passes. Production deploys, promote, rollback,
# aliases, env/secrets, domains and every other subcommand are blocked:
# an allow-list, so a subcommand nobody has thought of is refused by default.
# Global options (--cwd, --token, --scope, ...) are skipped to find the real
# subcommand, and a production flag anywhere in argv is refused.
REAL_VERCEL="${NEXUS_RUNNER_REAL_VERCEL:-}"
[ -x "$REAL_VERCEL" ] || REAL_VERCEL=$(PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin command -v vercel)

deny() { echo "nexus-runner: BLOCKED 'vercel $*' (protected action; needs the founder or a release mandate)" >&2; exit 3; }

prev=""
for a in "$@"; do
  case "$a" in
    --prod|--prod=*|--target=production|--target=prod) deny "production deploy" ;;
  esac
  case "$prev" in
    --target) case "$a" in production|prod) deny "production deploy" ;; esac ;;
  esac
  prev="$a"
done

# Defence in depth: an unlisted value-taking global option could shift the
# subcommand, so a mutating subcommand word anywhere in argv is refused too.
for a in "$@"; do
  case "$a" in
    promote|rollback|redeploy|alias|aliases|env|domains|domain|dns|certs|cert|remove|rm|project|projects|teams|team|switch|pull|link|integration|integrations|secrets|git|rolling-release|blob|target|targets|buy|redirects|routes|flags|cache|microfrontends|login|logout|init) deny "$a" ;;
  esac
done

# First non-option word is the subcommand (or a deploy path, or absent = deploy).
sub=""; skip=0
for a in "$@"; do
  if [ "$skip" = 1 ]; then skip=0; continue; fi
  case "$a" in
    --cwd|--token|-t|--scope|-S|--team|-T|--local-config|-A|--global-config|-Q|--api|--target|--meta|-m|--env|-e|--build-env|-b|--regions|--archive) skip=1; continue ;;
    -*) continue ;;
  esac
  sub="$a"; break
done

case "$sub" in
  inspect|ls|list|logs|whoami|build|help) : ;;
  ""|deploy|.|./*|/*) : ;;
  *) deny "$sub" ;;
esac
exec "$REAL_VERCEL" "$@"
