#!/bin/sh
# nexus-runner gh shim — the release half of the runner's reversible envelope
# (policy: ../mission-authority.json). Opening or updating a DRAFT PR is a build
# step and passes. Merging, marking ready, a non-draft PR, releases, secrets,
# workflow runs, repo settings and any gh api write are protected and blocked.
# Holds even under bypassPermissions (the permission engine is off; this is not).
REAL_GH="${NEXUS_RUNNER_REAL_GH:-}"
[ -x "$REAL_GH" ] || REAL_GH=$(PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin command -v gh)

deny() { echo "nexus-runner: BLOCKED 'gh $*' (protected action; needs the founder or a release mandate)" >&2; exit 3; }

case "$1" in
  pr)
    case "$2" in
      merge) deny "pr merge" ;;
      ready) deny "pr ready" ;;
      create)
        draft=0
        for a in "$@"; do
          case "$a" in --draft|-d|--draft=true) draft=1 ;; esac
        done
        [ "$draft" = 1 ] || deny "pr create without --draft"
        ;;
    esac
    ;;
  api)
    # Read-only GETs only. -f/-F/--field/--input make gh api send a POST.
    for a in "$@"; do
      case "$a" in
        -X|--method|--method=*|-X*|-f|-F|--field|--field=*|--raw-field|--raw-field=*|--input|--input=*) deny "api write" ;;
      esac
    done
    ;;
  release|secret|variable|workflow|ruleset|auth) deny "$1" ;;
  repo)
    case "$2" in delete|edit|archive|rename|deploy-key) deny "repo $2" ;; esac
    ;;
esac
exec "$REAL_GH" "$@"
